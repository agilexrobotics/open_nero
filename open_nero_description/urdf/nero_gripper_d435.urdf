    <child link="${prefix}link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-2.75" upper="2.75" velocity="5"/>
  </joint>
  <link name="${prefix}link4">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00031334623 -0.05675192422 0.00076056133"/>
      <mass value="0.48451414"/>
