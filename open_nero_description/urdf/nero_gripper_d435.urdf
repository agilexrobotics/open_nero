  <joint name="${prefix}joint6" type="revolute">
    <origin rpy="1.5707963  -1.5707963  0" xyz="0 0 0"/>
    <parent link="${prefix}link5"/>
    <child link="${prefix}link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-0.73" upper="0.95" velocity="5"/>
  </joint>
  <link name="${prefix}link7">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00014000 -0.00010000 -0.00275000"/>
      <mass value="0.000001"/>
      <inertia ixx="1.1000000000000001e-07" ixy="0" ixz="0" iyy="1.1000000000000001e-07" iyz="0" izz="1.9999999999999999e-07"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/dae/link7.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/link7.stl"/>
      </geometry>
    </collision>
