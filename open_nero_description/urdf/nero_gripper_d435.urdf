      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/gripper_base.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}gripper_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0055"/>
    <parent link="${prefix}gripper_flange"/>
    <child link="${prefix}gripper_base"/>
  </joint>
  <link name="${prefix}gripper_link1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/dae/gripper_link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/gripper_link1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}gripper_joint1" type="prismatic">
    <origin rpy="1.5707963 0 3.1415926" xyz="0 0 0.1358"/>
    <parent link="${prefix}gripper_base"/>
    <child link="${prefix}gripper_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="0" upper="0.05" velocity="3"/>
  </joint>
  <link name="${prefix}gripper_link2">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
