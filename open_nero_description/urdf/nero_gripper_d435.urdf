      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/nero/meshes/gripper_flange.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}gripper_flange_joint" type="fixed">
    <origin rpy="-1.5708 0 -1.5708" xyz="0.032 0 -0.0235"/>
    <parent link="${prefix}link7"/>
    <child link="${prefix}gripper_flange"/>
  </joint>
  <link name="${prefix}gripper_base">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876"/>
      <mass value="0.45"/>
      <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
